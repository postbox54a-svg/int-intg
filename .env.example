# apps/ingest only — never expose these to apps/web.
# Missing keys are fine: the matching worker logs a line and is skipped.

# Redis (dev: `service redis-server start`)
REDIS_URL=redis://localhost:6379

# Ingest HTTP + WebSocket gateway
INGEST_PORT=8787
LOG_LEVEL=info

# Phase 3 – OpenSky fallback (OAuth2 client credentials)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Phase 6 – AISStream
AISSTREAM_API_KEY=

# Phase 7 – PostGIS history
# DATABASE_URL=postgres://indpulse:indpulse@localhost:5432/indpulse
