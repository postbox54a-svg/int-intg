# apps/ingest only — never expose these to apps/web.
# Missing keys are fine: the matching worker logs a line and is skipped.

# Redis (dev: `service redis-server start`)
REDIS_URL=redis://localhost:6379

# Ingest HTTP + WebSocket gateway
INGEST_PORT=8787
LOG_LEVEL=info

# Phase 2 – Earthquakes. Optional override of the USGS feed; a file:// URL reads a local fixture, e.g. when
# earthquake.usgs.gov is blocked: USGS_FEED_URL=file:///absolute/path/to/fixtures/usgs-quakes.synthetic.geojson
# USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_week.geojson

# Phase 3 – Flights. adsb.lol is primary and needs no key. ADSBLOL_BASE_URL may be a file:// fixture
# (read as one complete response), e.g. file:///abs/path/fixtures/adsblol-flights.synthetic.json
# ADSBLOL_BASE_URL=https://api.adsb.lol
# OpenSky fallback (OAuth2 client credentials); without both values the fallback is disabled.
# OPENSKY_API_URL may also be a file:// fixture: fixtures/opensky-states.synthetic.json
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Phase 4 – Alerts. Optional override of the SACHET RSS feed; a file:// URL reads the fixture feed, whose CAP links
# are relative to it: SACHET_RSS_URL=file:///abs/path/fixtures/sachet/rss.xml
# SACHET_RSS_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml

# Phase 6 – AISStream
AISSTREAM_API_KEY=

# Phase 7 – PostGIS history
# DATABASE_URL=postgres://indpulse:indpulse@localhost:5432/indpulse
